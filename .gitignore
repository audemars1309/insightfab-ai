# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Dataset (large; provided separately by KLA — do not commit)
# NOTE: leading slash anchors these to the repo root so they do NOT match the
# source package src/data/ (an unanchored `data/` matched any nested dir).
/data/
/semicon_dataset/
*.zip

# Model checkpoints (large binaries; distributed separately per portal rules).
# Ignore the whole weights/ tree so nested experiment subdirs
# (e.g. weights/nafnet_sr_A_e80/best.pt) are never accidentally committed.
weights/

# Generated outputs
results/benchmark_out/
/output/
*.log

# Secrets / environment
.env
*.env
.env.*
*.key
*.pem
secrets.*

# Official KLA sponsor documents (copyrighted material — not redistributed via this repo)
KLA Problem Statement_explanation.pptx
KLA_Problem Statement_Studen help document.pdf

# OS / editor
.DS_Store
__MACOSX/
.idea/
.vscode/

# Keep directory placeholders and small tracked artifacts
!results/dataset_audit/**
!experiments/**
